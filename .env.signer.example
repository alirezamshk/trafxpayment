# ONLY on the signer host — never on the API/worker hosts. Back the mnemonic up offline.
SIGNER_MNEMONIC=

# Cold wallets (addresses of wallets whose keys are NOT on this server, e.g. a hardware wallet).
# Hot-wallet balance above each asset's "hot wallet cap" (admin panel) is moved here automatically.
COLD_WALLET_TRON=
COLD_WALLET_EVM=
COLD_WALLET_TON=
SWEEP_INTERVAL_MS=60000
TRON_SWEEP_TRX_TOPUP=30
TRON_SWEEP_FEE_LIMIT_TRX=50
