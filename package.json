{
  "name": "trafxpayment",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted crypto payment gateway with automatic deposit confirmation (TRON, EVM, TON)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "start:api": "node dist/bin/api.js",
    "start:worker": "node dist/bin/worker.js",
    "migrate": "tsx src/bin/migrate.ts",
    "keys:generate": "tsx src/bin/generate-keys.ts",
    "merchant:create": "tsx src/bin/create-merchant.ts",
    "test": "vitest run",
    "dev:signer": "tsx watch src/bin/signer.ts",
    "start:signer": "node dist/bin/signer.js",
    "migrate:prod": "node dist/bin/migrate.js",
    "admin:create": "tsx src/bin/create-admin.ts"
  },
  "dependencies": {
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "ethers": "^6.17.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tronweb": "^6.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
