{
	skip_install_trust
	servers {
		# Only these may set X-Forwarded-For (Cloudflare ranges when the site sits behind Cloudflare).
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# Let's Encrypt via ports 80/443 (install.sh always sets ACME_EMAIL in this mode).
(tls_acme) {
	tls {$ACME_EMAIL}
}

# Behind Cloudflare (orange cloud, SSL mode "Full"): Cloudflare serves the public certificate,
# this self-signed one only encrypts Cloudflare -> server. Works on any Cloudflare-supported port.
(tls_internal) {
	tls internal
}

# Behind Cloudflare with SSL mode "Full (strict)": a Cloudflare Origin Certificate
# (SSL/TLS -> Origin Server -> Create certificate) saved as deploy/certs/origin.pem + origin-key.pem.
(tls_origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
}

# Behind Cloudflare with SSL mode "Flexible" (like the RadiusCloud servers): Cloudflare serves HTTPS
# to visitors and talks plain HTTP to this server; CADDY_SITE is then http://<domain>.
(tls_off) {
}

{$CADDY_SITE} {
	import tls_{$CADDY_TLS:acme}
	encode gzip
	reverse_proxy api:3000
}
