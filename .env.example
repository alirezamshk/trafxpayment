# ---------- Core ----------
DATABASE_URL=postgres://postgres:postgres@db:5432/trafxpayment
PORT=3000
PUBLIC_BASE_URL=https://pay.example.com
LOG_LEVEL=info

# ---------- Invoices ----------
INVOICE_TTL_MINUTES=30
LATE_PAYMENT_WINDOW_HOURS=24
UNDERPAY_TOLERANCE_PERCENT=0

# ---------- Platform / settlement ----------
DEFAULT_FEE_PERCENT=1
SETTLEMENT_HOUR_UTC=6
PAYOUT_REQUIRE_APPROVAL=true
SESSION_TTL_HOURS=12
ALLOW_MERCHANT_SIGNUP=false

# ---------- Watch-only keys (output of `npm run keys:generate`) ----------
EVM_XPUB=
TRON_XPUB=
TON_TREASURY_ADDRESS=

# ---------- TRON ----------
TRON_ENABLED=true
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# ---------- EVM (a chain is enabled when its RPC URL is set) ----------
ETH_RPC_URL=
ETH_CONFIRMATIONS=12
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_CONFIRMATIONS=15
POLYGON_RPC_URL=
POLYGON_CONFIRMATIONS=64

# ---------- TON ----------
TON_ENABLED=true
TON_API_URL=https://toncenter.com/api/v3
TON_V2_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=

# ---------- Prices ----------
PRICE_API_URL=https://api.coingecko.com/api/v3
PRICE_API_KEY=
STABLECOIN_USD_PEG=true

# ---------- Webhooks ----------
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_TIMEOUT_MS=10000
